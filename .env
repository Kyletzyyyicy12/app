# Web1 API Configuration (for mobile email integration)
EXPO_PUBLIC_WEB1_API_URL=http://localhost:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# Email Configuration for CobyPicks App
# Gmail credentials (using the web1 backend for email sending)

# Primary Gmail SMTP Configuration (matches web1 backend)
EXPO_PUBLIC_EMAIL_USER=kyse.quimada.swu@phinmaed.com
EXPO_PUBLIC_EMAIL_PASSWORD=eevdmjhynotvjryz
EXPO_PUBLIC_EMAIL_FROM="CobyPicks Security <noreply@cobypicks.com>"
EXPO_PUBLIC_EMAIL_SMTP_HOST=smtp.gmail.com
EXPO_PUBLIC_EMAIL_SMTP_PORT=587
EXPO_PUBLIC_EMAIL_SECURE=false

# Alternative Email Providers (optional)
EXPO_PUBLIC_SENDGRID_API_KEY=your-sendgrid-api-key
EXPO_PUBLIC_MAILGUN_API_KEY=your-mailgun-api-key
EXPO_PUBLIC_MAILGUN_DOMAIN=your-mailgun-domain

# Firebase Functions (set to false if not using)
EXPO_PUBLIC_USE_FIREBASE_FUNCTIONS=true

# Development Mode (set to false in production)
EXPO_PUBLIC_ENABLE_DEV_MODE=true

# Email Queue Settings
EXPO_PUBLIC_EMAIL_MAX_RETRIES=5
EXPO_PUBLIC_EMAIL_RETRY_DELAY=30000
EXPO_PUBLIC_EMAIL_QUEUE_INTERVAL=30000