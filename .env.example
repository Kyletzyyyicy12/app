# CobyPicks Mobile App Environment Variables

# Free Email Server URL (where your deployed email server is running)
EXPO_PUBLIC_FREE_EMAIL_SERVER_URL=https://your-deployed-email-server.com

# Alternative: API URL (fallback)
EXPO_PUBLIC_API_URL=https://your-deployed-email-server.com

# Original Web1 API URL (no longer needed, kept for reference)
# EXPO_PUBLIC_WEB1_API_URL=http://localhost:3000

# Firebase Configuration (if not already set)
EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-app-id